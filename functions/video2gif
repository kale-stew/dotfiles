#!/bin/bash
#
# video2gif — Convert a video clip to an optimized, shareable GIF
#
# Usage:
#   video2gif my-video.mp4
#   video2gif my-video.mp4 --start 00:00:05 --duration 3
#   video2gif /path/to/video.mp4 --fps 20 --width 600
#
# Dependencies: ffmpeg, gifski, gifsicle
# Input:        filename (defaults to ~/Downloads), relative path, or absolute path
# Output:       ~/Downloads/<basename>.gif
#

set -euo pipefail

DOWNLOADS="$HOME/Downloads"
WORK_DIR=""  # Set later via mktemp

# ------------------------------------------------------------------
# Defaults (optimized for sharing on X, Google Chat, email)
# ------------------------------------------------------------------
FPS=15
WIDTH=480
LOSSY=80
START=""
DURATION=""

# ------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------
info()    { printf "  [ \033[00;34m..\033[0m ] %s\n" "$1"; }
success() { printf "\r\033[2K  [ \033[00;32mOK\033[0m ] %s\n" "$1"; }
fail()    { printf "\r\033[2K  [\033[0;31mFAIL\033[0m] %s\n" "$1"; exit 1; }

cleanup() {
  if [[ -n "$WORK_DIR" && -d "$WORK_DIR" ]]; then
    rm -rf "$WORK_DIR"
  fi
}

trap cleanup EXIT

usage() {
  cat <<EOF
Usage: video2gif <filename> [options]

Options:
  -s, --start <time>      Start time (e.g. 00:00:05 or 5)
  -d, --duration <secs>   Clip duration in seconds
  --fps <n>               Frames per second (default: 15)
  --width <px>            Output width in pixels (default: 480)
  --lossy <n>             Gifsicle lossy level (default: 80)
  -h, --help              Show this help

Examples:
  video2gif my-video.mp4
  video2gif my-video.mp4 -s 00:00:05 -d 3
  video2gif my-video.mp4 --fps 20 --width 600
EOF
}

# ------------------------------------------------------------------
# Parse arguments
# ------------------------------------------------------------------
if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

# Check for help before treating first arg as filename
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 0
fi

FILENAME="$1"
shift

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--start)
      [[ -z "${2:-}" || "$2" == -* ]] && fail "--start requires a time value"
      START="$2"
      shift 2
      ;;
    -d|--duration)
      [[ -z "${2:-}" || "$2" == -* ]] && fail "--duration requires a value"
      DURATION="$2"
      shift 2
      ;;
    --fps)
      [[ -z "${2:-}" || "$2" == -* ]] && fail "--fps requires a value"
      [[ "$2" =~ ^[1-9][0-9]*$ ]] || fail "--fps must be a positive integer"
      FPS="$2"
      shift 2
      ;;
    --width)
      [[ -z "${2:-}" || "$2" == -* ]] && fail "--width requires a value"
      [[ "$2" =~ ^[1-9][0-9]*$ ]] || fail "--width must be a positive integer"
      WIDTH="$2"
      shift 2
      ;;
    --lossy)
      [[ -z "${2:-}" || "$2" == -* ]] && fail "--lossy requires a value"
      [[ "$2" =~ ^[0-9]+$ && "$2" -le 200 ]] || fail "--lossy must be 0-200"
      LOSSY="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "Unknown option: $1"
      ;;
  esac
done

# ------------------------------------------------------------------
# Validate dependencies
# ------------------------------------------------------------------
for tool in ffmpeg gifski gifsicle; do
  if ! command -v "$tool" &>/dev/null; then
    fail "$tool is not installed. Run: brew install $tool"
  fi
done

# ------------------------------------------------------------------
# Validate input
# ------------------------------------------------------------------
# Accept absolute paths, relative paths, or filenames (default to ~/Downloads)
if [[ "$FILENAME" == /* ]]; then
  # Absolute path
  INPUT="$FILENAME"
elif [[ "$FILENAME" == */* ]]; then
  # Relative path
  INPUT="$(pwd)/$FILENAME"
else
  # Just a filename, default to ~/Downloads
  INPUT="$DOWNLOADS/$FILENAME"
fi

if [[ ! -f "$INPUT" ]]; then
  fail "Input not found: $INPUT"
fi

BASENAME="$(basename "${FILENAME%.*}")"
OUTPUT="$DOWNLOADS/${BASENAME}.gif"

# Check for existing output
if [[ -f "$OUTPUT" ]]; then
  fail "Output already exists: $OUTPUT (delete it or rename the input)"
fi

WORK_DIR="$(mktemp -d -t video2gif.XXXXXX)"

# ------------------------------------------------------------------
# Step 1: Trim (optional)
# ------------------------------------------------------------------
if [[ -n "$START" || -n "$DURATION" ]]; then
  info "Trimming video clip..."

  TRIM_OPTS=()
  if [[ -n "$START" ]]; then
    TRIM_OPTS+=("-ss" "$START")
  fi
  if [[ -n "$DURATION" ]]; then
    TRIM_OPTS+=("-t" "$DURATION")
  fi

  CLIP="$WORK_DIR/clip.${FILENAME##*.}"
  # Re-encode (not -c copy) to allow accurate cuts on non-keyframe boundaries
  ffmpeg -y -hide_banner -loglevel error \
    "${TRIM_OPTS[@]}" \
    -i "$INPUT" \
    "$CLIP"

  INPUT="$CLIP"
  success "Trimmed clip created"
fi

# ------------------------------------------------------------------
# Step 2: Convert to GIF with gifski
# ------------------------------------------------------------------
info "Converting to GIF (${FPS}fps, ${WIDTH}px)..."

RAW_GIF="$WORK_DIR/raw.gif"
gifski \
  --fps "$FPS" \
  --width "$WIDTH" \
  -o "$RAW_GIF" \
  "$INPUT"

RAW_SIZE=$(du -h "$RAW_GIF" | cut -f1)
success "GIF created ($RAW_SIZE)"

# ------------------------------------------------------------------
# Step 3: Optimize with gifsicle
# ------------------------------------------------------------------
info "Optimizing GIF (lossy=$LOSSY)..."

gifsicle \
  -O3 \
  --lossy="$LOSSY" \
  --colors 256 \
  "$RAW_GIF" \
  -o "$OUTPUT"

FINAL_SIZE=$(du -h "$OUTPUT" | cut -f1)
success "Optimized GIF saved: $OUTPUT ($FINAL_SIZE)"
